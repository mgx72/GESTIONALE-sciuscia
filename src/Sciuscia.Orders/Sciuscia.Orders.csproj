<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sciuscia.Orders</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solo Sciuscia.Data (AppPaths/DatabaseInitializer/FoundationOptions/NumberingService):
         Sciuscia.Foundations referenzia già Orders per il proprio autotest, quindi Orders non
         deve referenziare Foundations né Registry per non creare un ciclo. Gli identificativi
         di categoria/marca/artigiano passati ai servizi qui dentro sono validati dal database
         stesso (foreign key attive su ogni connessione, vedi OpenReadyConnectionAsync). -->
    <ProjectReference Include="..\Sciuscia.Data\Sciuscia.Data.csproj" />
  </ItemGroup>
</Project>
